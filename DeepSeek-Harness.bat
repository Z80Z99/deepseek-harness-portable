:RUN
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l=[IO.File]::ReadAllLines('%~f0',[Text.Encoding]::UTF8);$s=[Array]::IndexOf($l,'__DSH_PS_B64_BEGIN__');$e=[Array]::IndexOf($l,'__DSH_PS_B64_END__');if($s -lt 0 -or $e -lt 0){exit 9};$b=[Convert]::FromBase64String(($l[($s+1)..($e-1)] -join ''));$p='%~dp0.dsh-bootstrap.ps1';try{[IO.File]::WriteAllBytes($p,$b)}catch{try{[IO.File]::WriteAllBytes((Join-Path $env:TEMP 'dsh-bootstrap.ps1'),$b)}catch{exit 9}}" <nul
if exist "%BS%" (set "BS_USE=%BS%") else (set "BS_USE=%TEMP%\dsh-bootstrap.ps1")
if not exist "%BS_USE%" goto :FAIL
goto :MAIN

:FAIL
echo [DeepSeek-Harness] bootstrap extraction failed. The file may be corrupted.
pause
exit /b 9

REM The bootstrap PS line below must stay the LAST command in this
REM file: the bootstrap may rewrite this bat in place, and cmd reads
REM sequentially - anything after the final command would run as
REM garbage (error 9009).
:MAIN
powershell -NoProfile -ExecutionPolicy Bypass -File "%BS_USE%" -Root "%~dp0." -AppVersion "%APP_VERSION%" -AppBuilt "%APP_BUILT%" -DshPin "%DSH_PIN%" -UserArgs "%*"
